{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://api.bilimtrack.kg/api/$1" },
    { "source": "/health/(.*)", "destination": "https://api.bilimtrack.kg/health/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
