# Backend the dev server proxies /api and /health to (bilimtrack_v2_back).
# Local backend: http://localhost:8000
VITE_API_PROXY_TARGET=https://api.bilimtrack.kg

# API base the app calls. Unset: "/api/v1" in dev (through the proxy above),
# https://api.bilimtrack.kg/api/v1 in a production build (the panel's domain
# must then be in the backend's CORS_ALLOWED_ORIGINS).
# VITE_API_URL=/api/v1

# Backend health endpoint (django-health-check), same rules as VITE_API_URL.
# VITE_HEALTH_URL=/health/

# Access: only Bilimtrack platform operators (backend ops.PlatformOperator,
# checked through GET /api/v1/ops/me/). Accounts: `manage.py create_ops_admins`.

# Public origin of the deployed panel: og:url / og:image in index.html need an absolute URL
# for link previews (Telegram, WhatsApp, Slack). Default: https://ops.bilimtrack.kg
# VITE_PUBLIC_URL=https://ops.bilimtrack.kg

# Public blog, for the «На сайте» button in the article editor. Default: https://bilimtrack.kg/blog
# VITE_BLOG_URL=https://bilimtrack.kg/blog
