# Backend the dev server proxies /api and /health to (bilimtrack_v2_back).
# Local backend: http://localhost:8000
VITE_API_PROXY_TARGET=https://api.bilimtrack.kg

# API base the app calls. Keep "/api/v1" in dev (goes through the proxy);
# for a production build point it at the API, e.g. https://api.bilimtrack.kg/api/v1
VITE_API_URL=/api/v1

# Backend health endpoint (django-health-check), same rules as VITE_API_URL.
VITE_HEALTH_URL=/health/

# The global helpdesk account: the backend gives it cross-organization access
# to tickets and account search (settings.BILIMTRACK_SUPPORT_USERNAME).
VITE_SUPPORT_USERNAME=bilimtrack_tech_support
